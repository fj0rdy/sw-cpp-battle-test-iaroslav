{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Battle: debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/sw_battle_test",
            "args": [
                "${workspaceFolder}/commands_example.txt"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "CMake: build",
            "windows": {
                "program": "${workspaceFolder}/build/debug/sw_battle_test.exe",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
                "environment": [
                    {
                        "name": "PATH",
                        "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                    }
                ]
            },
            "linux": {
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}